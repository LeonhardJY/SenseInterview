# Docker Compose 环境变量示例
# 复制为 docker/.env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
#
# 启动方式：
#   cd docker && docker-compose up -d --build
# 或：docker-compose -f docker/docker-compose.yml up -d --build

# MySQL root 密码（同时用于各后端服务连接数据库，需保持一致）
MYSQL_PASSWORD=123456

# 数据库用户名（默认 root）
SPRING_DATASOURCE_USERNAME=root

# JWT 签名密钥（各微服务共享，需 >= 32 字符，生产环境请生成随机值）
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-char-secret

# DeepSeek API Key（ai-service 使用）
SENSE_LLM_KEY=sk-your-deepseek-api-key-here
