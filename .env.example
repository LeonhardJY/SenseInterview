# SenseInterview 环境变量配置
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# DeepSeek API Key（必填，否则 LLM 无法使用）
SENSE_LLM_KEY=sk-your-deepseek-api-key-here

# MySQL 数据库连接（各后端服务使用，本地开发请填本机 MySQL 账号密码）
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-mysql-password

# JWT 签名密钥（各微服务共享，需 >= 32 字符，生产环境请生成随机值）
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-char-secret

# 阿里云 NLP（可选，未配置时使用占位值）
SENSE_NLP_APP_KEY=your-app-key
SENSE_NLP_ACCESS_KEY_ID=your-access-key-id
SENSE_NLP_ACCESS_KEY_SECRET=your-access-key-secret
